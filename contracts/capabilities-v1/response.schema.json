{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrimServ local public capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "service",
    "version",
    "capabilities",
    "data_source"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "service": {
      "const": "primserv-core"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])"
    },
    "data_source": {
      "const": "local_mock"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materials"
      ],
      "properties": {
        "materials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "path",
            "methods",
            "languages",
            "max_limit"
          ],
          "properties": {
            "contract": {
              "const": "materials-v1"
            },
            "path": {
              "const": "/api/v1/materials/"
            },
            "methods": {
              "const": [
                "GET"
              ]
            },
            "languages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "max_limit": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
